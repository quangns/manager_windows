<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Cho phép build project net10.0-windows (WPF, Windows Service) trên Linux -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.11.4</Version>
    <Product>Manager Windows</Product>
    <Authors>Nguyễn Sỹ Quang</Authors>
  </PropertyGroup>
</Project>
