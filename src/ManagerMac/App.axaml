<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ManagerMac.App"
             RequestedThemeVariant="Default">
    <!-- Giao diện theo docs/design/DESIGN.md (cùng bảng màu với bản Windows). Fluent theme tự đổi sáng/tối theo macOS. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Canvas" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Raised" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="Ink" Color="#18181B" />
                    <SolidColorBrush x:Key="InkMuted" Color="#71717A" />
                    <SolidColorBrush x:Key="Hairline" Color="#E4E4E7" />
                    <SolidColorBrush x:Key="Accent" Color="#0F766E" />
                    <SolidColorBrush x:Key="AccentFill" Color="#0F766E" />
                    <SolidColorBrush x:Key="AccentFillHover" Color="#115E59" />
                    <SolidColorBrush x:Key="AccentWash" Color="#E6F2F1" />
                    <SolidColorBrush x:Key="ChartBar" Color="#118F80" />
                    <SolidColorBrush x:Key="Warning" Color="#B45309" />
                    <SolidColorBrush x:Key="WarningWash" Color="#FEF3C7" />
                    <SolidColorBrush x:Key="Critical" Color="#B91C1C" />
                    <SolidColorBrush x:Key="Good" Color="#15803D" />
                    <SolidColorBrush x:Key="GoodWash" Color="#DCFCE7" />
                    <Color x:Key="SystemAccentColor">#0F766E</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Canvas" Color="#09090B" />
                    <SolidColorBrush x:Key="Surface" Color="#18181B" />
                    <SolidColorBrush x:Key="Raised" Color="#27272A" />
                    <SolidColorBrush x:Key="Ink" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="InkMuted" Color="#B4B4BC" />
                    <SolidColorBrush x:Key="Hairline" Color="#34343A" />
                    <SolidColorBrush x:Key="Accent" Color="#3FB8A9" />
                    <SolidColorBrush x:Key="AccentFill" Color="#0F766E" />
                    <SolidColorBrush x:Key="AccentFillHover" Color="#11806F" />
                    <SolidColorBrush x:Key="AccentWash" Color="#12302D" />
                    <SolidColorBrush x:Key="ChartBar" Color="#2A9D8F" />
                    <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
                    <SolidColorBrush x:Key="WarningWash" Color="#2E2109" />
                    <SolidColorBrush x:Key="Critical" Color="#F87171" />
                    <SolidColorBrush x:Key="Good" Color="#4ADE80" />
                    <SolidColorBrush x:Key="GoodWash" Color="#0F2A1A" />
                    <Color x:Key="SystemAccentColor">#2A9D8F</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="UiFont">avares://ManagerMac/Assets/Fonts#Be Vietnam Pro</FontFamily>
            <FontFamily x:Key="MonoFont">avares://ManagerMac/Assets/Fonts#JetBrains Mono</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Chữ -->
        <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="TextBlock.cardTitle"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.overline">
            <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style Selector="TextBlock.big">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Thẻ -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Border.table">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="11" /><Setter Property="Padding" Value="9,2" />
            <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Raised}" />
        </Style>
        <Style Selector="Border.badge.warn"><Setter Property="Background" Value="{DynamicResource WarningWash}" /></Style>
        <Style Selector="Border.badge.good"><Setter Property="Background" Value="{DynamicResource GoodWash}" /></Style>

        <!-- Nút: chính (nền teal, chữ trắng), phụ, liên kết -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16,7" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentFill}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillHover}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFill}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentWash}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource Critical}" /></Style>

        <!-- Thanh dung lượng / thanh ngang -->
        <Style Selector="ProgressBar.meter">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="8" /><Setter Property="MinHeight" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource Raised}" />
        </Style>
        <Style Selector="ProgressBar.bar">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="6" /><Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource ChartBar}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Sidebar -->
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,10" /><Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentWash}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Bảng -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Hairline}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="RowHeight" Value="36" />
        </Style>
    </Application.Styles>
</Application>
