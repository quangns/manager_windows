<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ManagerMac.ViewModels" xmlns:l="using:ManagerMac.Services" x:Class="ManagerMac.Views.CleanupView" x:DataType="vm:CleanupViewModel">
    <DockPanel Margin="32,28,32,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{l:T Tab_Cleanup}" Classes="title" />
                <TextBlock Text="{l:T Clean_Subtitle}" Classes="muted" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{l:T Clean_Scan}" Command="{Binding ScanCommand}" IsEnabled="{Binding !Busy}" />
                <Button Classes="primary" Content="{l:T Clean_Run}" Command="{Binding RunCommand}" IsEnabled="{Binding !Busy}" />
            </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="6"><ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding Busy}" Foreground="{DynamicResource Accent}" Background="Transparent" /><TextBlock Text="{Binding Status}" Classes="muted" /></StackPanel>
        <Grid RowDefinitions="2*,Auto,*">
            <Border Classes="table">
                <DataGrid ItemsSource="{Binding Rules}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:RuleRow">
                                    <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T Col_Rule}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:RuleRow">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <Border Classes="badge warn" IsVisible="{Binding IsReview}">
                                            <TextBlock Text="{l:T Risk_Review}" Foreground="{DynamicResource Warning}" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T Col_Files}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:RuleRow"><TextBlock Text="{Binding Files}" Classes="num" Margin="0,0,12,0" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T Col_Estimate}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:RuleRow"><TextBlock Text="{Binding Estimate}" Classes="num" Margin="0,0,12,0" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:RuleRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Classes="link" Content="{l:T Clean_Review}" IsVisible="{Binding CanReview}"
                                                Command="{Binding $parent[DataGrid].((vm:CleanupViewModel)DataContext).ReviewCommand}" CommandParameter="{Binding}" />
                                        <Border Classes="badge good" IsVisible="{Binding Reviewed}">
                                            <TextBlock Text="{l:T Clean_Reviewed}" Foreground="{DynamicResource Good}" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Grid.Row="1" Text="{l:T Clean_History}" Classes="cardTitle" Margin="0,20,0,10" />
            <Border Grid.Row="2" Classes="table">
                <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Col_Time}" Binding="{Binding Time, DataType=vm:HistoryRow}" Width="170" />
                        <DataGridTextColumn Header="{l:T Col_Freed}" Binding="{Binding Freed, DataType=vm:HistoryRow}" Width="140" />
                        <DataGridTextColumn Header="{l:T Col_Deleted}" Binding="{Binding Deleted, DataType=vm:HistoryRow}" Width="110" />
                        <DataGridTextColumn Header="{l:T Col_Skipped}" Binding="{Binding Failed, DataType=vm:HistoryRow}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
