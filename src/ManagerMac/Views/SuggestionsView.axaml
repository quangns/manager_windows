<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ManagerMac.ViewModels" xmlns:l="using:ManagerMac.Services" x:Class="ManagerMac.Views.SuggestionsView" x:DataType="vm:SuggestionsViewModel">
    <DockPanel Margin="32,28,32,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{l:T Tab_Suggestions}" Classes="title" />
                <TextBlock Text="{l:T Mac_SugNote}" Classes="muted" Margin="0,4,24,0" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="{l:T Sug_Scan}" Command="{Binding ScanCommand}" IsEnabled="{Binding !Busy}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="6"><ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding Busy}" Foreground="{DynamicResource Accent}" Background="Transparent" /><TextBlock Text="{Binding Status}" Classes="muted" /></StackPanel>
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16">
            <StackPanel Spacing="6">
                <TextBlock Text="{l:T Mac_SugRoots}" FontWeight="Medium" />
                <TextBox Text="{Binding RootsText}" AcceptsReturn="True" Height="76" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
            </StackPanel>
        </Border>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="200">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ILabeled"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="1" Text="{Binding SelectedSummary}" Classes="muted" VerticalAlignment="Center" Margin="16,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="{l:T Sug_SelectAll}" Command="{Binding SelectAllVisibleCommand}" />
                <Button Classes="primary" Content="{l:T Mac_MoveToTrash}" Command="{Binding MoveToTrashCommand}" IsEnabled="{Binding !Busy}" />
            </StackPanel>
        </Grid>
        <Border Classes="table">
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:SuggestionRow"><CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T Col_Kind}" Binding="{Binding KindText, DataType=vm:SuggestionRow}" Width="150" IsReadOnly="True" />
                    <DataGridTextColumn Header="{l:T Col_Path}" Binding="{Binding Path, DataType=vm:SuggestionRow}" Width="*" MinWidth="240" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="{l:T Col_Size}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:SuggestionRow"><TextBlock Text="{Binding SizeText}" Classes="num" Margin="0,0,12,0" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T Col_LastUsed}" Binding="{Binding LastUsed, DataType=vm:SuggestionRow}" Width="120" IsReadOnly="True" />
                    <DataGridTemplateColumn Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:SuggestionRow">
                                <Button Classes="link" Content="{l:T Mac_Reveal}"
                                        Command="{Binding $parent[DataGrid].((vm:SuggestionsViewModel)DataContext).RevealCommand}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
