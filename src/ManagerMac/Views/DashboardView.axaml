<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ManagerMac.ViewModels" xmlns:l="using:ManagerMac.Services" x:Class="ManagerMac.Views.DashboardView" x:DataType="vm:DashboardViewModel">
    <DockPanel Margin="32,28,32,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{l:T Tab_Dashboard}" Classes="title" />
                <TextBlock Text="{l:T Mac_DashSubtitle}" Classes="muted" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{l:T Btn_Refresh}" Command="{Binding RefreshCommand}" />
                <Button Classes="primary" Content="{l:T Dash_QuickClean}" Command="{Binding QuickCleanCommand}" IsEnabled="{Binding !Busy}" />
            </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="6"><ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding Busy}" Foreground="{DynamicResource Accent}" Background="Transparent" /><TextBlock Text="{Binding Status}" Classes="muted" /></StackPanel>
        <!-- Lưới lệch 2:1 -->
        <Grid ColumnDefinitions="2*,16,*" VerticalAlignment="Top">
            <StackPanel Spacing="16">
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:T Mac_Disk}" Classes="cardTitle" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <TextBlock Text="{Binding DiskFree}" Classes="big" />
                            <TextBlock Text="{l:T Dash_FreeSuffix}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </StackPanel>
                        <TextBlock Classes="muted"><Run Text="{l:T Dash_Of}" /><Run Text=" " /><Run Text="{Binding DiskTotal}" /></TextBlock>
                        <ProgressBar Classes="meter" Value="{Binding DiskUsed}" Height="10" Margin="0,8,0,0" />
                        <TextBlock Text="{l:T Mac_DiskLow}" Foreground="{DynamicResource Critical}" IsVisible="{Binding DiskLow}" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="RAM" Classes="cardTitle" />
                        <TextBlock Text="{Binding RamText}" Classes="big" FontSize="22" Margin="0,8,0,0" />
                        <ProgressBar Classes="meter" Value="{Binding RamUsed}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="16">
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:T Dash_TotalFreed}" Classes="overline" />
                        <TextBlock Text="{Binding TotalFreed}" Classes="big" FontSize="20" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:T Dash_LastCleanup}" Classes="overline" />
                        <TextBlock Text="{Binding LastCleanup}" Classes="big" FontSize="20" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
