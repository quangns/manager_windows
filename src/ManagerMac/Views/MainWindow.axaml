<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ManagerMac.ViewModels"
        xmlns:v="using:ManagerMac.Views"
        x:Class="ManagerMac.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Manager Mac" Width="1180" Height="780" MinWidth="960" MinHeight="620"
        Icon="/Assets/icon.png" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:DashboardViewModel"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="vm:CleanupViewModel"><v:CleanupView /></DataTemplate>
        <DataTemplate DataType="vm:SuggestionsViewModel"><v:SuggestionsView /></DataTemplate>
        <DataTemplate DataType="vm:ProcessesViewModel"><v:ProcessesView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
    </Window.DataTemplates>
    <Grid ColumnDefinitions="232,*">
        <!-- Sidebar -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,24,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="10,0,0,24">
                    <Image Source="/Assets/icon.png" Width="28" Height="28" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Manager Mac" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding EditionText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Classes="muted" />
                    </StackPanel>
                </StackPanel>
                <ListBox Classes="nav" ItemsSource="{Binding Nav}" SelectedItem="{Binding Selected}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Data="{Binding Icon}" Stroke="{Binding $parent[ListBoxItem].Foreground}" StrokeThickness="1.6"
                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding Selected.Page}" />
    </Grid>
</Window>
