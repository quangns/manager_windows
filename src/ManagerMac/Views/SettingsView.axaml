<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ManagerMac.ViewModels" xmlns:l="using:ManagerMac.Services" x:Class="ManagerMac.Views.SettingsView" x:DataType="vm:SettingsViewModel">
    <DockPanel Margin="32,28,32,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{l:T Tab_Settings}" Classes="title" />
                <TextBlock Text="{l:T Set_Subtitle}" Classes="muted" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="{l:T Btn_Save}" Command="{Binding SaveCommand}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="6"><ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding Busy}" Foreground="{DynamicResource Accent}" Background="Transparent" /><TextBlock Text="{Binding Status}" Classes="muted" /></StackPanel>
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l:T Set_Appearance}" Classes="cardTitle" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{l:T Set_Language}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="200">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ILabeled"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{l:T Set_Theme}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="200">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ILabeled"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l:T Set_Behaviour}" Classes="cardTitle" />
                    <CheckBox Content="{l:T Mac_StartAtLogin}" IsChecked="{Binding StartAtLogin}" />
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{l:T Set_Data}" Classes="cardTitle" />
                    <TextBlock Text="{l:T Set_Privacy}" Classes="muted" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding DataDir}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="{l:T Set_OpenData}" Command="{Binding OpenDataFolderCommand}" />
                    </Grid>
                    <TextBlock Classes="muted"><Run Text="Manager Mac " /><Run Text="{Binding Version}" /></TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
