<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ManagerMac.ViewModels" xmlns:l="using:ManagerMac.Services" x:Class="ManagerMac.Views.ProcessesView" x:DataType="vm:ProcessesViewModel">
    <DockPanel Margin="32,28,32,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{l:T Tab_Processes}" Classes="title" />
                <TextBlock Text="{l:T Mac_ProcSubtitle}" Classes="muted" Margin="0,4,24,0" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="{l:T Proc_FreeMemory}" Command="{Binding PurgeCommand}"
                    IsEnabled="{Binding !Busy}" ToolTip.Tip="{l:T Mac_PurgeHint}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="6"><ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding Busy}" Foreground="{DynamicResource Accent}" Background="Transparent" /><TextBlock Text="{Binding Status}" Classes="muted" /></StackPanel>
        <!-- Chỉ số tức thời -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,24,*,24,*">
                <StackPanel Spacing="4">
                    <TextBlock Text="CPU" Classes="overline" />
                    <TextBlock Text="{Binding CpuTotalText}" Classes="big" />
                    <ProgressBar Classes="meter" Maximum="100" Value="{Binding CpuTotal}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="RAM" Classes="overline" />
                    <TextBlock Text="{Binding RamText}" Classes="big" FontSize="20" Margin="0,4,0,4" />
                    <ProgressBar Classes="meter" Value="{Binding RamUsed}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="4">
                    <TextBlock Text="{l:T Proc_Count}" Classes="overline" />
                    <TextBlock Text="{Binding ProcessCount}" Classes="big" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Lọc, sắp xếp, tìm -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="220" Margin="0,0,8,0">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ILabeled"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" Width="130" Margin="0,0,12,0">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ILabeled"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Column="2" Text="{Binding Search}" Watermark="{l:T Prio_Search}" />
        </Grid>
        <Border Classes="table">
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{l:T Col_App}" Width="*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ProcessRow">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Path}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{l:T Col_Kind}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ProcessRow">
                                <Border Classes="badge"><TextBlock Text="{Binding KindText}" FontSize="12" Foreground="{DynamicResource InkMuted}" /></Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{l:T Col_Processes}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ProcessRow"><TextBlock Text="{Binding Count}" Classes="num" Margin="0,0,12,0" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="CPU" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ProcessRow">
                                <Grid ColumnDefinitions="*,58" VerticalAlignment="Center" Margin="8,0">
                                    <ProgressBar Classes="bar" Value="{Binding CpuRatio}" />
                                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" Classes="num" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="RAM" Width="135">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ProcessRow">
                                <Grid ColumnDefinitions="*,80" VerticalAlignment="Center" Margin="8,0">
                                    <ProgressBar Classes="bar" Value="{Binding RamRatio}" />
                                    <TextBlock Grid.Column="1" Text="{Binding RamText}" Classes="num" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="270">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ProcessRow">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="link" Content="{l:T Proc_Restart}" IsVisible="{Binding CanRestart}"
                                            Command="{Binding $parent[DataGrid].((vm:ProcessesViewModel)DataContext).RestartCommand}" CommandParameter="{Binding}" />
                                    <Button Classes="link danger" Content="{l:T Proc_EndTask}" IsVisible="{Binding CanEnd}"
                                            Command="{Binding $parent[DataGrid].((vm:ProcessesViewModel)DataContext).EndTaskCommand}" CommandParameter="{Binding}" />
                                    <Button Classes="link" Content="{l:T Mac_RevealShort}" ToolTip.Tip="{l:T Mac_Reveal}"
                                            Command="{Binding $parent[DataGrid].((vm:ProcessesViewModel)DataContext).RevealCommand}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
