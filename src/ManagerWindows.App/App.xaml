<Application x:Class="ManagerWindows.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ManagerWindows.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Màu: nền, chữ chính/phụ, nhấn, đường kẻ -->
        <SolidColorBrush x:Key="Surface" Color="#FCFCFB" />
        <SolidColorBrush x:Key="Panel" Color="#F4F3F0" />
        <SolidColorBrush x:Key="Ink" Color="#0B0B0B" />
        <SolidColorBrush x:Key="InkMuted" Color="#52514E" />
        <SolidColorBrush x:Key="Accent" Color="#2A78D6" />
        <SolidColorBrush x:Key="Hairline" Color="#E1E0D9" />
        <SolidColorBrush x:Key="Critical" Color="#C62828" />
        <SolidColorBrush x:Key="Warning" Color="#8A5A00" />
        <SolidColorBrush x:Key="Good" Color="#006300" />

        <cv:NotConverter x:Key="Not" />
        <cv:BoolToVisibilityConverter x:Key="BoolVis" />
        <cv:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
        <cv:StringToVisibilityConverter x:Key="StrVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,6" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Hairline}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="RowBackground" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowHeight" Value="28" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </Application.Resources>
</Application>
