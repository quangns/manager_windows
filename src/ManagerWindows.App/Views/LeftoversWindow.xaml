<Window x:Class="ManagerWindows.App.Views.LeftoversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ManagerWindows.App.Services"
        xmlns:c="clr-namespace:ManagerWindows.App.Controls"
        Title="{l:T Left_Title}" Width="1040" Height="660" MinWidth="760" MinHeight="420"
        Icon="/Assets/app.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <!-- Danh sách tiến trình sót: chỉ gợi ý, người dùng chọn rồi mới dừng -->
    <DockPanel Margin="28,24,28,20">
        <c:PageHeader DockPanel.Dock="Top" Title="{l:T Left_Title}" Subtitle="{l:T Left_Subtitle}">
            <c:PageHeader.Actions>
                <Button Style="{StaticResource Secondary}" Content="{l:T Left_Rescan}" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
            </c:PageHeader.Actions>
        </c:PageHeader>

        <!-- Chân: tóm tắt + nút -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource Secondary}" Content="{l:T Sug_SelectAll}" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource Primary}" Content="{l:T Left_StopSelected}" Command="{Binding StopSelectedCommand}"
                            IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
            </DockPanel>
            <StackPanel Margin="0,10,0,0">
                <ProgressBar Style="{StaticResource BusyLine}" Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" />
            </StackPanel>
        </StackPanel>

        <!-- Giải thích ngắn: không phải mục nào cũng là rác -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,12,0" />
                <TextBlock Text="{l:T Left_Explain}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid>
            <!-- Trạng thái trống -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="32" Foreground="{DynamicResource Good}" HorizontalAlignment="Center" />
                <TextBlock Text="{l:T Left_NoneFound}" Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
            <Border Style="{StaticResource TableCard}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisInv}}">
                <DataGrid c:Table.Apply="True" ItemsSource="{Binding Items}" IsReadOnly="True" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T Col_App}" Width="*" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Pids}">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkMuted}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Lý do: huy hiệu có biểu tượng + chữ -->
                        <DataGridTemplateColumn Header="{l:T Left_Reason}" Width="290">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Border Style="{StaticResource BadgeCritical}" Margin="0,0,6,0" Visibility="{Binding IsHung, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE783;" />
                                                <TextBlock Text="{l:T Left_Reason_Hung}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource BadgeWarning}" Margin="0,0,6,0" Visibility="{Binding IsOrphan, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE7BA;" />
                                                <TextBlock Text="{l:T Left_Reason_Orphan}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource BadgeWarning}" Margin="0,0,6,0" Visibility="{Binding IsWindowClosed, Converter={StaticResource BoolVis}}"
                                                ToolTip="{l:T Left_Reason_ClosedTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE8BB;" />
                                                <TextBlock Text="{l:T Left_Reason_Closed}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource BadgeNeutral}" Visibility="{Binding IsIdle, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE823;" />
                                                <TextBlock Text="{l:T Left_Reason_Idle}" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T Col_Processes}" Width="90" SortMemberPath="Count">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Count}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="RAM" Width="100" SortMemberPath="Ram">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RamText}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T Left_Age}" Binding="{Binding AgeText}" Width="120" />
                        <DataGridTemplateColumn Width="230">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{l:T Left_Stop}" Style="{StaticResource Link}" Foreground="{DynamicResource Critical}"
                                                Command="{Binding DataContext.StopOneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{l:T Left_Ignore}" Style="{StaticResource Link}"
                                                Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{l:T Sug_OpenFolder}" Style="{StaticResource Link}"
                                                Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
