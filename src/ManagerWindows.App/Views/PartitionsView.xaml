<UserControl x:Class="ManagerWindows.App.Views.PartitionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ManagerWindows.App.Services"
             xmlns:c="clr-namespace:ManagerWindows.App.Controls"
             Foreground="{DynamicResource Ink}">
    <!-- Quản lý phân vùng: dùng chung cho tab trong cửa sổ chính và cửa sổ riêng chạy quyền Admin -->
    <UserControl.Resources>
        <!-- Ô phân vùng trên sơ đồ đĩa: dải màu trên cùng theo loại, viền accent khi đang chọn -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,4,0" SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentWash}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="free">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Canvas}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentStrip" TargetType="Border">
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="5,5,0,0" />
            <Setter Property="Background" Value="{DynamicResource ChartBar}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="windows">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="system">
                    <Setter Property="Background" Value="{DynamicResource InkMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="free">
                    <Setter Property="Background" Value="{DynamicResource Hairline}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Nút thao tác: thao tác xoá dữ liệu chữ đỏ; bị khoá vẫn hiện tooltip lý do -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Secondary}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Critical}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Style="{StaticResource Page}">
        <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Partitions}" Subtitle="{l:T Part_Subtitle}">
            <c:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Secondary}" Content="{l:T Btn_Refresh}" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                    <Button Style="{StaticResource Primary}" Content="{l:T Part_OpenAdmin}" Command="{Binding OpenElevatedCommand}"
                            Visibility="{Binding NotElevated, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </c:PageHeader.Actions>
        </c:PageHeader>
        <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Cảnh báo: sao lưu trước; chưa có quyền Admin thì chỉ xem -->
                <Border Style="{StaticResource BadgeWarning}" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE7BA;" />
                        <TextBlock Text="{l:T Part_BackupWarn}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" Visibility="{Binding NotElevated, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock Text="{l:T Part_ReadOnlyNote}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                <!-- Thao tác dời phân vùng đang dở (mất điện, lỗi, bấm Dừng): phải tiếp tục trước khi dùng phân vùng đó -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" BorderBrush="{DynamicResource Critical}" BorderThickness="2"
                        Visibility="{Binding HasPending, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{l:T Part_ActResume}" Command="{Binding ResumeCommand}"
                                IsEnabled="{Binding Busy, Converter={StaticResource Not}}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Critical}" VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" Margin="0,0,12,0" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" Visibility="{Binding HasLoadError, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LoadError}" Foreground="{DynamicResource Critical}" TextWrapping="Wrap" />
                </Border>

                <!-- Sơ đồ đĩa -->
                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Info}" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Segments}" Height="96">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <c:ProportionalPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="c:ProportionalPanel.Weight" Value="{Binding Weight}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SegmentButton}" ToolTip="{Binding Title}"
                                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Top" Style="{StaticResource SegmentStrip}" />
                                                        <ProgressBar DockPanel.Dock="Bottom" Style="{StaticResource Meter}" Height="4" Margin="8,0,8,8"
                                                                     Value="{Binding UsedRatio, Mode=OneWay}" Visibility="{Binding HasUsage, Converter={StaticResource BoolVis}}" />
                                                        <StackPanel Margin="8,6,8,4">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FsText}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Chi tiết + thao tác cho ô đang chọn -->
                <Border Style="{StaticResource Card}" Margin="0,4,0,16" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" Margin="0,6,0,14" LineHeight="20" />
                        <ItemsControl ItemsSource="{Binding Actions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ActionButton}" Command="{Binding Command}" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding Reason}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,4,0,16" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisInv}}">
                    <TextBlock Text="{l:T Part_SelectHint}" Style="{StaticResource Muted}" />
                </Border>

                <!-- Giới hạn: những gì MiniTool làm được mà app không làm -->
                <TextBlock Text="{l:T Part_Limits}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
