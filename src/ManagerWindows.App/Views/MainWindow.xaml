<Window x:Class="ManagerWindows.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ManagerWindows.App.Services"
        xmlns:vm="clr-namespace:ManagerWindows.App.ViewModels"
        Title="{l:T App_Title}" Width="1100" Height="720" MinWidth="900" MinHeight="560"
        Icon="/Assets/app.ico" Background="{StaticResource Panel}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="NavTab" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="16,10" Margin="0,0,0,2" CornerRadius="6" Background="Transparent">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEBE7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Width" Value="190" />
        </Style>

        <!-- Thanh trạng thái dùng chung cho các tab -->
        <DataTemplate x:Key="StatusBar">
            <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="6" Margin="0,0,10,0"
                                 Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <TabControl TabStripPlacement="Left" SelectedIndex="{Binding SelectedTab}" Background="{StaticResource Panel}"
                BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource NavTab}">

        <!-- ===================== TỔNG QUAN ===================== -->
        <TabItem Header="{l:T Tab_Dashboard}" DataContext="{Binding Dashboard}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="{l:T Btn_Refresh}" Command="{Binding RefreshCommand}" />
                        <Button Content="{l:T Dash_QuickClean}" Style="{StaticResource Primary}" Command="{Binding QuickCleanCommand}"
                                IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                    </StackPanel>
                    <TextBlock Text="{l:T Tab_Dashboard}" Style="{StaticResource H1}" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Width="380">
                            <StackPanel>
                                <TextBlock Text="{l:T Dash_Drives}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Drives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding FreeText}" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,4,0,0"
                                                             Foreground="{StaticResource Accent}" Background="{StaticResource Hairline}" BorderThickness="0" />
                                                <TextBlock Text="{l:T Dash_LowSpace}" Foreground="{StaticResource Critical}" FontSize="12"
                                                           Visibility="{Binding Low, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="300">
                            <StackPanel>
                                <TextBlock Text="{l:T Dash_TotalFreed}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding TotalFreed}" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,10" />
                                <TextBlock Text="{l:T Dash_LastCleanup}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding LastCleanup}" Margin="0,2,0,10" />
                                <TextBlock Text="{l:T Dash_Service}" Style="{StaticResource Muted}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="●  " Foreground="{StaticResource Good}" Visibility="{Binding ServiceOk, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="●  " Foreground="{StaticResource Warning}" Visibility="{Binding ServiceOk, Converter={StaticResource BoolVisInv}}" />
                                    <TextBlock Text="{Binding ServiceStatus}" TextWrapping="Wrap" Width="240" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="300">
                            <StackPanel>
                                <TextBlock Text="{l:T Dash_TopToday}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding TopToday}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding ActiveText}" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
                                                <TextBlock Text="{Binding Name}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
                <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
            </Grid>
        </TabItem>

        <!-- ===================== DỌN RÁC ===================== -->
        <TabItem Header="{l:T Tab_Cleanup}" DataContext="{Binding Cleanup}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="{l:T Clean_Scan}" Command="{Binding ScanCommand}" IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                        <Button Content="{l:T Clean_Run}" Style="{StaticResource Primary}" Command="{Binding RunCommand}"
                                IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                    </StackPanel>
                    <TextBlock Text="{l:T Tab_Cleanup}" Style="{StaticResource H1}" />
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T Col_Rule}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{l:T Risk_Review}" Foreground="{StaticResource Warning}" Margin="8,0,0,0" FontSize="12"
                                                   Visibility="{Binding IsReview, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T Col_Scope}" Binding="{Binding ScopeText}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:T Col_Files}" Binding="{Binding Files}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:T Col_Estimate}" Binding="{Binding Estimate}" Width="110" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:T Clean_Schedule}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding Frequencies}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Frequency}" Width="120" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Days}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Day}" Width="110" Margin="0,0,8,0" />
                    <TextBlock Text="{l:T Sched_Hour}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding Hour}" Width="60" Margin="0,0,12,0" />
                    <TextBlock Text="{l:T Sched_Idle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding IdleMinutes}" Width="40" VerticalContentAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Content="{l:T Sched_SkipBattery}" IsChecked="{Binding SkipOnBattery}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="{l:T Btn_Save}" Command="{Binding SaveScheduleCommand}" />
                </WrapPanel>

                <DockPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Text="{l:T Clean_History}" Style="{StaticResource H2}" DockPanel.Dock="Top" />
                    <DataGrid ItemsSource="{Binding History}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Col_Time}" Binding="{Binding Time}" Width="150" />
                            <DataGridTextColumn Header="{l:T Col_Trigger}" Binding="{Binding Trigger}" Width="120" />
                            <DataGridTextColumn Header="{l:T Col_Freed}" Binding="{Binding Freed}" Width="110" />
                            <DataGridTextColumn Header="{l:T Col_Deleted}" Binding="{Binding Deleted}" Width="90" />
                            <DataGridTextColumn Header="{l:T Col_Skipped}" Binding="{Binding Failed}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <ContentControl Grid.Row="4" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
            </Grid>
        </TabItem>

        <!-- ===================== GỢI Ý DỌN ===================== -->
        <TabItem Header="{l:T Tab_Suggestions}" DataContext="{Binding Suggestions}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button Content="{l:T Sug_Scan}" Style="{StaticResource Primary}" Command="{Binding ScanCommand}" DockPanel.Dock="Right"
                            IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                    <TextBlock Text="{l:T Tab_Suggestions}" Style="{StaticResource H1}" />
                </DockPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="{l:T Sug_Note}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <TextBlock Text="{l:T Sug_Roots}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding RootsText}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{l:T Sug_LastAccessOff}" Foreground="{StaticResource Warning}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding LastAccessOff, Converter={StaticResource BoolVis}}" />
                </StackPanel>
                <DockPanel Grid.Row="2" Margin="0,10,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="{l:T Sug_SelectAll}" Command="{Binding SelectAllVisibleCommand}" />
                        <Button Content="{l:T Sug_Recycle}" Style="{StaticResource Primary}" Command="{Binding RecycleSelectedCommand}"
                                IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Kinds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding KindFilter}" Width="200" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding SelectedSummary}" VerticalAlignment="Center" Margin="12,0" Style="{StaticResource Muted}" />
                </DockPanel>
                <DataGrid Grid.Row="3" ItemsSource="{Binding View}" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T Col_Kind}" Binding="{Binding KindText}" Width="140" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:T Col_Path}" Binding="{Binding Path}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:T Col_Size}" Binding="{Binding SizeText}" Width="90" IsReadOnly="True" SortMemberPath="Size" />
                        <DataGridTextColumn Header="{l:T Col_LastUsed}" Binding="{Binding LastUsed}" Width="110" IsReadOnly="True" />
                        <DataGridTemplateColumn Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{l:T Sug_OpenFolder}" Style="{StaticResource Link}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ContentControl Grid.Row="4" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
            </Grid>
        </TabItem>

        <!-- ===================== DI CHUYỂN DATA ===================== -->
        <TabItem Header="{l:T Tab_Relocation}" DataContext="{Binding Relocation}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button Content="{l:T Reloc_Detect}" Style="{StaticResource Primary}" Command="{Binding DetectCommand}" DockPanel.Dock="Right"
                            IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                    <TextBlock Text="{l:T Tab_Relocation}" Style="{StaticResource H1}" />
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="{l:T Reloc_Intro}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T Reloc_TargetRoot}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding TargetRoot}" Width="320" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="{l:T Reloc_Browse}" Command="{Binding BrowseCommand}" />
                    </StackPanel>
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Col_App}" Binding="{Binding AppName}" Width="170" />
                        <DataGridTextColumn Header="{l:T Col_Path}" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="{l:T Col_Size}" Binding="{Binding SizeText}" Width="90" />
                        <DataGridTextColumn Header="{l:T Col_Status}" Binding="{Binding StatusText}" Width="200" />
                        <DataGridTemplateColumn Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{l:T Reloc_Move}" Style="{StaticResource Link}"
                                            Visibility="{Binding CanMove, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.MoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0"
                        Visibility="{Binding SelectedFolder.Note, Converter={StaticResource StrVis}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding SelectedFolder.Note}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Grid.Row="4" Text="{l:T Reloc_History}" Style="{StaticResource H2}" />
                <DataGrid Grid.Row="5" ItemsSource="{Binding Records}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Col_Source}" Binding="{Binding Source}" Width="*" />
                        <DataGridTextColumn Header="{l:T Col_Target}" Binding="{Binding Target}" Width="*" />
                        <DataGridTextColumn Header="{l:T Col_Size}" Binding="{Binding SizeText}" Width="80" />
                        <DataGridTextColumn Header="{l:T Col_State}" Binding="{Binding StateText}" Width="150" />
                        <DataGridTemplateColumn Header="{l:T Col_Health}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding HealthText}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HealthBad}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Critical}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{l:T Reloc_Resume}" Style="{StaticResource Link}"
                                                Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{l:T Reloc_Rollback}" Style="{StaticResource Link}"
                                                Visibility="{Binding CanRollback, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{l:T Reloc_DeleteBackup}" Style="{StaticResource Link}"
                                                Visibility="{Binding CanDeleteBackup, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ContentControl Grid.Row="6" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
            </Grid>
        </TabItem>

        <!-- ===================== THỐNG KÊ SỬ DỤNG ===================== -->
        <TabItem Header="{l:T Tab_Usage}" DataContext="{Binding Usage}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ComboBox ItemsSource="{Binding Periods}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding PeriodDays}" Width="130" Margin="0,0,8,0" />
                        <Button Content="{l:T Btn_Refresh}" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <TextBlock Text="{l:T Tab_Usage}" Style="{StaticResource H1}" />
                </DockPanel>

                <!-- Biểu đồ cột một chuỗi: thời gian dùng máy theo giờ trong ngày. Không cần chú giải (tiêu đề đã nêu). -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding TotalText}" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
                            <TextBlock Text="{l:T Usage_Hourly}" FontWeight="SemiBold" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Hours}" Height="160">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Vùng hover cao hết biểu đồ để dễ trỏ chuột vào cột thấp -->
                                    <Grid Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="18" />
                                        </Grid.RowDefinitions>
                                        <Border Height="{Binding Height}" VerticalAlignment="Bottom" Margin="1,0"
                                                Background="{StaticResource Accent}" CornerRadius="4,4,0,0" />
                                        <Border Grid.Row="1" Background="{StaticResource Hairline}" />
                                        <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11" HorizontalAlignment="Left"
                                                   Foreground="{StaticResource InkMuted}" Margin="0,3,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Apps}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Col_App}" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="{l:T Col_ActiveTime}" Binding="{Binding ActiveText}" Width="140" SortMemberPath="ActiveSeconds" />
                        <DataGridTextColumn Header="{l:T Col_Launches}" Binding="{Binding Launches}" Width="100" />
                        <DataGridTextColumn Header="{l:T Col_Sessions}" Binding="{Binding Sessions}" Width="100" />
                        <DataGridTextColumn Header="{l:T Col_Path}" Binding="{Binding Exe}" Width="*" />
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{l:T Usage_Pin}" Style="{StaticResource Link}"
                                            Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="{l:T Usage_NoLaunches}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Visibility="{Binding LaunchesAvailable, Converter={StaticResource BoolVisInv}}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===================== ƯU TIÊN & EXCEL ===================== -->
        <TabItem Header="{l:T Tab_Priority}" DataContext="{Binding Priority}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <DockPanel>
                        <Button Content="{l:T Btn_Save}" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" DockPanel.Dock="Right" />
                        <TextBlock Text="{l:T Tab_Priority}" Style="{StaticResource H1}" />
                    </DockPanel>
                    <TextBlock Text="{l:T Prio_Intro}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                    <CheckBox Content="{l:T Prio_Enabled}" IsChecked="{Binding Enabled}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{l:T Prio_TopN}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding TopUsedCount}" Width="40" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="{l:T Prio_AllowHigh}" IsChecked="{Binding AllowHigh}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T Prio_Pinned}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PinnedText}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T Prio_Background}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding BackgroundText}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{l:T Prio_Managed}" Style="{StaticResource H2}" />
                    <DataGrid ItemsSource="{Binding Managed}" IsReadOnly="True" MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Col_App}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                            <DataGridTextColumn Header="{l:T Col_Original}" Binding="{Binding Original}" Width="140" />
                            <DataGridTextColumn Header="{l:T Col_Applied}" Binding="{Binding Applied}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{l:T Excel_Section}" Style="{StaticResource H2}" Margin="0,20,0,6" />
                    <CheckBox Content="{l:T Excel_Enabled}" IsChecked="{Binding ExcelEnabled}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{l:T Excel_Threshold}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding HeavyFileMb}" Width="50" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ExcelStatus}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <Button Content="{l:T Excel_Analyze}" Command="{Binding PickAndAnalyzeCommand}" HorizontalAlignment="Left"
                            IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            Visibility="{Binding ReportTitle, Converter={StaticResource StrVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReportTitle}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding ReportSummary}" Style="{StaticResource Muted}" Margin="0,4,0,10" />
                            <ItemsControl ItemsSource="{Binding ExcelSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Severity}" Width="90" FontWeight="SemiBold" DockPanel.Dock="Left">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Critical}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Critical}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== CÀI ĐẶT ===================== -->
        <TabItem Header="{l:T Tab_Settings}" DataContext="{Binding Settings}">
            <StackPanel Margin="20" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="{l:T Tab_Settings}" Style="{StaticResource H1}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{l:T Set_Language}" VerticalAlignment="Center" Width="220" />
                    <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Language}" Width="160" />
                </StackPanel>
                <CheckBox Content="{l:T Set_StartWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10" />
                <CheckBox Content="{l:T Set_UsageEnabled}" IsChecked="{Binding UsageEnabled}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{l:T Set_Retention}" VerticalAlignment="Center" Width="220" />
                    <TextBox Text="{Binding RetentionDays}" Width="60" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="{l:T Set_BackupKeep}" VerticalAlignment="Center" Width="220" />
                    <TextBox Text="{Binding BackupKeepDays}" Width="60" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="{l:T Btn_Save}" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" />
                    <Button Content="{l:T Set_OpenData}" Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
                <TextBlock Text="{l:T Set_Privacy}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Muted}">
                    <Run Text="Manager Windows " /><Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding DataDir}" Style="{StaticResource Muted}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
