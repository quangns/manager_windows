<Window x:Class="ManagerWindows.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ManagerWindows.App.Services"
        xmlns:c="clr-namespace:ManagerWindows.App.Controls"
        Title="{l:T App_Title}" Width="1240" Height="800" MinWidth="1000" MinHeight="640"
        Icon="/Assets/app.ico" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <!-- Bố cục theo docs/design/DESIGN.md: sidebar 232px + vùng nội dung tối đa 1200px. -->
    <Window.Resources>
        <!-- Chân trang: thanh tải mảnh 2px + chữ trạng thái -->
        <DataTemplate x:Key="StatusBar">
            <StackPanel Margin="0,12,0,0">
                <ProgressBar Style="{StaticResource BusyLine}" Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" />
            </StackPanel>
        </DataTemplate>

        <!-- Thanh dung lượng đổi màu theo mức đầy: ok / warn (< 15%) / low (< 10%) -->
        <Style x:Key="DriveMeter" TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="warn">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="low">
                    <Setter Property="Foreground" Value="{DynamicResource Critical}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Biểu tượng và huy hiệu theo mức: critical / warn(ing) / ok / info -->
        <Style x:Key="LevelIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="critical">
                    <Setter Property="Foreground" Value="{DynamicResource Critical}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="warn">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ok">
                    <Setter Property="Foreground" Value="{DynamicResource Good}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelBadge" TargetType="Border" BasedOn="{StaticResource BadgeNeutral}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="critical">
                    <Setter Property="Background" Value="{DynamicResource CriticalWash}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Critical}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="warning">
                    <Setter Property="Background" Value="{DynamicResource WarningWash}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Khung trang: lề 32px, rộng tối đa 1200px -->
        <Style x:Key="Page" TargetType="DockPanel">
            <Setter Property="Margin" Value="32,28,32,16" />
            <Setter Property="MaxWidth" Value="1200" />
        </Style>
        <Style x:Key="Gap" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Resources>

    <!-- Foreground đặt tại chỗ: nội dung trang thừa hưởng màu chữ từ TabControl, không để style mặc định (chữ đen) quyết định -->
    <TabControl x:Name="Nav" SelectedIndex="{Binding SelectedTab}" ItemContainerStyle="{StaticResource NavItem}"
                SelectionChanged="Nav_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0"
                Foreground="{DynamicResource Ink}">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Sidebar -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,1,0">
                        <DockPanel Margin="12,20,12,16">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,24">
                                <Image Source="/Assets/app.ico" Width="28" Height="28" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Manager Windows" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ink}" />
                                    <TextBlock Text="{l:T App_Tagline}" FontSize="11.5" Foreground="{DynamicResource InkMuted}" />
                                    <TextBlock Text="{Binding EditionText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{DynamicResource InkMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Trạng thái dịch vụ nền ở chân sidebar -->
                            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Raised}" CornerRadius="8" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Foreground="{DynamicResource Good}" Margin="0,0,8,0"
                                               Visibility="{Binding Dashboard.ServiceOk, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE7BA;" Foreground="{DynamicResource Warning}" Margin="0,0,8,0"
                                               Visibility="{Binding Dashboard.ServiceOk, Converter={StaticResource BoolVisInv}}" />
                                    <TextBlock Text="{Binding Dashboard.ServiceShort}" FontSize="12" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" Width="160" />
                                </StackPanel>
                            </Border>
                            <StackPanel IsItemsHost="True" />
                        </DockPanel>
                    </Border>
                    <ContentPresenter x:Name="PageHost" Grid.Column="1" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <!-- ===================== TỔNG QUAN ===================== -->
        <TabItem Tag="&#xE80F;" Header="{l:T Tab_Dashboard}" DataContext="{Binding Dashboard}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Dashboard}" Subtitle="{l:T Dash_Subtitle}">
                    <c:PageHeader.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Secondary}" Content="{l:T Btn_Refresh}" Command="{Binding RefreshCommand}" />
                            <Button Style="{StaticResource Primary}" Content="{l:T Dash_QuickClean}" Command="{Binding QuickCleanCommand}"
                                    IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                        </StackPanel>
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Lưới lệch 2:1 -->
                        <Grid Style="{StaticResource Gap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T Dash_Drives}" Style="{StaticResource CardTitle}" />
                                    <!-- Ổ hệ thống nổi bật -->
                                    <StackPanel DataContext="{Binding SystemDrive}" Margin="0,18,0,0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeWarning}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="warn">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE7BA;" />
                                                    <TextBlock Text="{l:T Dash_Warn}" />
                                                </StackPanel>
                                            </Border>
                                            <Border DockPanel.Dock="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeCritical}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="low">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE783;" />
                                                    <TextBlock Text="{l:T Dash_Low}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Style="{StaticResource Overline}">
                                                <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Label, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding FreeText}" Style="{StaticResource BigNumber}" />
                                            <TextBlock Text="{l:T Dash_FreeSuffix}" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,5" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,12">
                                            <Run Text="{l:T Dash_Of}" /> <Run Text="{Binding TotalText, Mode=OneWay}" />
                                        </TextBlock>
                                        <ProgressBar Style="{StaticResource DriveMeter}" Height="10" Value="{Binding UsedRatio, Mode=OneWay}" />
                                    </StackPanel>
                                    <!-- Các ổ còn lại -->
                                    <ItemsControl ItemsSource="{Binding OtherDrives}" Margin="0,20,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                                                    <ProgressBar Grid.Column="1" Style="{StaticResource DriveMeter}" Value="{Binding UsedRatio, Mode=OneWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Num}" Foreground="{DynamicResource InkMuted}" Margin="16,0,0,0">
                                                        <Run Text="{Binding FreeText, Mode=OneWay}" /> / <Run Text="{Binding TotalText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- Ba chỉ số xếp dọc -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{l:T Dash_TotalFreed}" Style="{StaticResource Overline}" />
                                        <TextBlock Text="{Binding TotalFreed}" Style="{StaticResource BigNumber}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{l:T Dash_LastCleanup}" Style="{StaticResource Overline}" />
                                        <TextBlock Text="{Binding LastCleanup}" Style="{StaticResource BigNumber}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LastCleanupDetail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:T Dash_TodayActive}" Style="{StaticResource Overline}" />
                                        <TextBlock Text="{Binding TodayActive}" Style="{StaticResource BigNumber}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Lưới 3:2 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <!-- Thanh ngang một chuỗi số liệu: thời gian dùng hôm nay -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T Dash_TopToday}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                                    <ItemsControl ItemsSource="{Binding TopToday}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10" Background="Transparent" ToolTip="{Binding ActiveText}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Foreground="{DynamicResource ChartBar}"
                                                                 Background="Transparent" Value="{Binding Ratio, Mode=OneWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ActiveText}" Style="{StaticResource Num}"
                                                               Foreground="{DynamicResource InkMuted}" MinWidth="90" Margin="12,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Trạng thái trống -->
                                    <StackPanel Visibility="{Binding HasTopApps, Converter={StaticResource BoolVisInv}}" Margin="0,8">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="28" Foreground="{DynamicResource InkMuted}" HorizontalAlignment="Left" />
                                        <TextBlock Text="{l:T Dash_NoAppsToday}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T Dash_Actions}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding Actions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource LevelIcon}" Text="{Binding Glyph}"
                                                                   VerticalAlignment="Top" Margin="0,1,12,0" />
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="{Binding ActionLabel}"
                                                                Visibility="{Binding ActionLabel, Converter={StaticResource StrVis}}" VerticalAlignment="Top"
                                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding Tab}" />
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ===================== DỌN RÁC ===================== -->
        <TabItem Tag="&#xEA99;" Header="{l:T Tab_Cleanup}" DataContext="{Binding Cleanup}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Cleanup}" Subtitle="{l:T Clean_Subtitle}">
                    <c:PageHeader.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Secondary}" Content="{l:T Clean_Scan}" Command="{Binding ScanCommand}"
                                    IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                            <Button Style="{StaticResource Primary}" Content="{l:T Clean_Run}" Command="{Binding RunCommand}"
                                    IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                        </StackPanel>
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />

                <!-- Lịch dọn tự động -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T Clean_Schedule}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <ComboBox ItemsSource="{Binding Frequencies}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Frequency}" Width="130" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding Days}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Day}" Width="120" Margin="0,0,8,0" />
                            <TextBlock Text="{l:T Sched_Hour}" VerticalAlignment="Center" Margin="4,0,6,0" />
                            <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding Hour}" Width="72" Margin="0,0,16,0" />
                            <TextBlock Text="{l:T Sched_Idle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding IdleMinutes}" Width="56" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                            <CheckBox Content="{l:T Sched_SkipBattery}" IsChecked="{Binding SkipOnBattery}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Secondary}" Content="{l:T Btn_Save}" Command="{Binding SaveScheduleCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{l:T Clean_AutoSkipsReview}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource TableCard}">
                        <DataGrid c:Table.Apply="True" ItemsSource="{Binding Rules}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Col_Rule}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource BadgeWarning}" Margin="10,0,0,0"
                                                        Visibility="{Binding IsReview, Converter={StaticResource BoolVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE7BA;" />
                                                        <TextBlock Text="{l:T Risk_Review}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Col_Scope}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeNeutral}">
                                                <TextBlock Text="{Binding ScopeText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Col_Files}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Files}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Col_Estimate}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Estimate}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding ReviewLabel}" Style="{StaticResource Link}"
                                                        Visibility="{Binding CanReview, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <Border Style="{StaticResource BadgeGood}" Visibility="{Binding Reviewed, Converter={StaticResource BoolVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE73E;" />
                                                        <TextBlock Text="{l:T Clean_Reviewed}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{l:T Clean_History}" Style="{StaticResource CardTitle}" Margin="0,20,0,10" />
                    <Border Grid.Row="2" Style="{StaticResource TableCard}">
                        <DataGrid c:Table.Apply="True" ItemsSource="{Binding History}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T Col_Time}" Binding="{Binding Time}" Width="160" />
                                <DataGridTextColumn Header="{l:T Col_Trigger}" Binding="{Binding Trigger}" Width="130" />
                                <DataGridTextColumn Header="{l:T Col_Freed}" Binding="{Binding Freed}" Width="130" />
                                <DataGridTextColumn Header="{l:T Col_Deleted}" Binding="{Binding Deleted}" Width="100" />
                                <DataGridTextColumn Header="{l:T Col_Skipped}" Binding="{Binding Failed}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ===================== GỢI Ý DỌN FILE ===================== -->
        <TabItem Tag="&#xEA80;" Header="{l:T Tab_Suggestions}" DataContext="{Binding Suggestions}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Suggestions}" Subtitle="{l:T Sug_Note}">
                    <c:PageHeader.Actions>
                        <Button Style="{StaticResource Primary}" Content="{l:T Sug_Scan}" Command="{Binding ScanCommand}"
                                IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{l:T Sug_Roots}" FontWeight="Medium" Margin="0,0,0,6" />
                        <TextBox Text="{Binding RootsText}" AcceptsReturn="True" Height="76" VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                        <Border Style="{StaticResource BadgeWarning}" Margin="0,10,0,0"
                                Visibility="{Binding LastAccessOff, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE7BA;" />
                                <TextBlock Text="{l:T Sug_LastAccessOff}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource Secondary}" Content="{l:T Sug_SelectAll}" Command="{Binding SelectAllVisibleCommand}" />
                        <Button Style="{StaticResource Primary}" Content="{l:T Sug_Recycle}" Command="{Binding RecycleSelectedCommand}"
                                IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Kinds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding KindFilter}" Width="200" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedSummary}" VerticalAlignment="Center" Margin="16,0" Style="{StaticResource Muted}" />
                </DockPanel>
                <Border Style="{StaticResource TableCard}">
                    <DataGrid c:Table.Apply="True" ItemsSource="{Binding View}" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T Col_Kind}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgeNeutral}">
                                            <TextBlock Text="{Binding KindText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T Col_Path}" Binding="{Binding Path}" Width="*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="{l:T Col_Size}" Width="100" SortMemberPath="Size">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T Col_LastUsed}" Binding="{Binding LastUsed}" Width="120" IsReadOnly="True" />
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{l:T Sug_OpenFolder}" Style="{StaticResource Link}"
                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ===================== DUNG LƯỢNG (kiểu TreeSize) ===================== -->
        <TabItem Tag="&#xEB05;" Header="{l:T Tab_DiskUsage}" DataContext="{Binding DiskUsage}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_DiskUsage}" Subtitle="{l:T Disk_Subtitle}">
                    <c:PageHeader.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Secondary}" Content="{l:T Disk_Stop}" Command="{Binding StopCommand}"
                                    Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" />
                            <Button Style="{StaticResource Primary}" Content="{l:T Disk_Scan}" Command="{Binding ScanCommand}"
                                    IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                        </StackPanel>
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />

                <!-- Chọn ổ / thư mục -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Drives}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedDrive}" Width="280" VerticalAlignment="Center" ToolTip="{l:T Disk_PickDrive}" />
                        <TextBox Grid.Column="1" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" Margin="12,0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center" ToolTip="{l:T Disk_PathHint}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ScanCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Style="{StaticResource Secondary}" Content="{l:T Disk_Browse}" Command="{Binding BrowseCommand}" />
                    </Grid>
                </Border>

                <!-- Tổng quan kết quả -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{l:T Disk_Total}" Style="{StaticResource Overline}" />
                            <TextBlock Text="{Binding TotalText}" Style="{StaticResource BigNumber}" FontSize="22" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{l:T Disk_Files}" Style="{StaticResource Overline}" />
                            <TextBlock Text="{Binding FilesText}" Style="{StaticResource BigNumber}" FontSize="22" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{l:T Disk_Dirs}" Style="{StaticResource Overline}" />
                            <TextBlock Text="{Binding DirsText}" Style="{StaticResource BigNumber}" FontSize="22" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Visibility="{Binding IsDriveRoot, Converter={StaticResource BoolVis}}">
                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding DriveRatio, Mode=OneWay}" />
                                <TextBlock Text="{Binding DriveText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{l:T Disk_Elapsed}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Muted}" Margin="4,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding ErrorsText}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasErrors, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Chọn kiểu xem -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource Secondary}" Content="{l:T Disk_ViewTree}" Command="{Binding ShowTreeCommand}" />
                        <Button Style="{StaticResource Secondary}" Content="{l:T Disk_ViewFiles}" Command="{Binding ShowFilesCommand}" />
                    </StackPanel>
                    <TextBlock Text="{l:T Disk_TreeTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"
                               Visibility="{Binding ShowTopFiles, Converter={StaticResource BoolVisInv}}" />
                    <TextBlock Text="{l:T Disk_FilesTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"
                               Visibility="{Binding ShowTopFiles, Converter={StaticResource BoolVis}}" />
                </DockPanel>

                <Grid>
                    <!-- Chưa quét -->
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding HasResult, Converter={StaticResource BoolVisInv}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEB05;" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,12,0" />
                            <TextBlock Text="{l:T Disk_Intro}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Cây thư mục: lớn đến bé, bấm mũi tên / nhấp đúp để mở -->
                    <Border Style="{StaticResource TableCard}" Visibility="{Binding TreeVisible, Converter={StaticResource BoolVis}}">
                        <DataGrid x:Name="DiskTree" c:Table.Apply="True" ItemsSource="{Binding Rows}" IsReadOnly="True" CanUserSortColumns="False"
                                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ToggleCommand}"
                                              CommandParameter="{Binding SelectedItem, ElementName=DiskTree}" />
                                <KeyBinding Key="Return" Command="{Binding ToggleCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=DiskTree}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:T Disk_ColName}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Link}" Width="22" Padding="0" Focusable="False"
                                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Chevron}" FontSize="10" Foreground="{DynamicResource InkMuted}" />
                                                </Button>
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{DynamicResource Accent}" Margin="2,0,8,0" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="11.5" Margin="8,0,0,0"
                                                           Visibility="{Binding Note, Converter={StaticResource StrVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Disk_ColShare}" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Style="{StaticResource Meter}" Height="6" Background="Transparent"
                                                             Foreground="{DynamicResource ChartBar}" Value="{Binding Ratio, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource Num}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Col_Size}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="Medium" Margin="0,0,12,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Disk_Files}" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FilesText}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Disk_Dirs}" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DirsText}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T Disk_ColModified}" Binding="{Binding LastWriteText}" Width="110" />
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="{l:T Disk_OpenExplorer}"
                                                          Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{l:T Disk_CopyPath}"
                                                          Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{l:T Disk_ScanHere}" IsEnabled="{Binding IsDir}"
                                                          Command="{Binding PlacementTarget.Tag.ScanHereCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="{l:T Disk_Recycle}" IsEnabled="{Binding IsMore, Converter={StaticResource Not}}"
                                                          Command="{Binding PlacementTarget.Tag.RecycleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Border>

                    <!-- File lớn nhất -->
                    <Border Style="{StaticResource TableCard}" Visibility="{Binding FilesVisible, Converter={StaticResource BoolVis}}">
                        <DataGrid c:Table.Apply="True" ItemsSource="{Binding TopFiles}" IsReadOnly="True" CanUserSortColumns="False"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:T Disk_ColName}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource InkMuted}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Col_Size}" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Style="{StaticResource Meter}" Height="6" Background="Transparent"
                                                             Foreground="{DynamicResource ChartBar}" Value="{Binding Ratio, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="Medium" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T Disk_ColModified}" Binding="{Binding LastWriteText}" Width="110" />
                                <DataGridTemplateColumn Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{l:T Sug_OpenFolder}" Style="{StaticResource Link}"
                                                    Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="{l:T Disk_OpenExplorer}"
                                                          Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{l:T Disk_CopyPath}"
                                                          Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="{l:T Disk_Recycle}"
                                                          Command="{Binding PlacementTarget.Tag.RecycleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Border>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ===================== DI CHUYỂN DATA APP ===================== -->
        <TabItem Tag="&#xE8DE;" Header="{l:T Tab_Relocation}" DataContext="{Binding Relocation}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Relocation}" Subtitle="{l:T Reloc_Intro}">
                    <c:PageHeader.Actions>
                        <Button Style="{StaticResource Primary}" Content="{l:T Reloc_Detect}" Command="{Binding DetectCommand}"
                                IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,14">
                    <DockPanel>
                        <TextBlock Text="{l:T Reloc_TargetRoot}" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="{l:T Reloc_Browse}" Command="{Binding BrowseCommand}" />
                        <TextBox Text="{Binding TargetRoot}" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource TableCard}">
                        <DataGrid c:Table.Apply="True" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T Col_App}" Binding="{Binding AppName}" Width="180" />
                                <DataGridTextColumn Header="{l:T Col_Path}" Binding="{Binding Path}" Width="*" />
                                <DataGridTemplateColumn Header="{l:T Col_Size}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Col_Status}" Width="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Border Style="{StaticResource BadgeGood}" Visibility="{Binding IsLinked, Converter={StaticResource BoolVis}}"
                                                        ToolTip="{Binding StatusText}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE73E;" />
                                                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource BadgeNeutral}" Visibility="{Binding IsManual, Converter={StaticResource BoolVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE946;" />
                                                        <TextBlock Text="{Binding StatusText}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{l:T Reloc_Move}" Style="{StaticResource Link}"
                                                    Visibility="{Binding CanMove, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.MoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <!-- Ghi chú của app đang chọn -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12"
                            Visibility="{Binding SelectedFolder.Note, Converter={StaticResource StrVis}, FallbackValue=Collapsed}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,12,0" />
                            <TextBlock Text="{Binding SelectedFolder.Note}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{l:T Reloc_History}" Style="{StaticResource CardTitle}" Margin="0,20,0,10" />
                    <Border Grid.Row="3" Style="{StaticResource TableCard}">
                        <DataGrid c:Table.Apply="True" ItemsSource="{Binding Records}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T Col_Source}" Binding="{Binding Source}" Width="*" />
                                <DataGridTextColumn Header="{l:T Col_Target}" Binding="{Binding Target}" Width="*" />
                                <DataGridTemplateColumn Header="{l:T Col_Size}" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T Col_State}" Binding="{Binding StateText}" Width="160" />
                                <DataGridTemplateColumn Header="{l:T Col_Health}" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Border Style="{StaticResource BadgeGood}" Visibility="{Binding HealthOk, Converter={StaticResource BoolVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE73E;" />
                                                        <TextBlock Text="{Binding HealthText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource BadgeCritical}" Visibility="{Binding HealthBad, Converter={StaticResource BoolVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource BadgeIcon}" Text="&#xE783;" />
                                                        <TextBlock Text="{Binding HealthText}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{l:T Reloc_Resume}" Style="{StaticResource Link}"
                                                        Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="{l:T Reloc_Rollback}" Style="{StaticResource Link}"
                                                        Visibility="{Binding CanRollback, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="{l:T Reloc_DeleteBackup}" Style="{StaticResource Link}"
                                                        Visibility="{Binding CanDeleteBackup, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ===================== THỐNG KÊ SỬ DỤNG ===================== -->
        <TabItem Tag="&#xE823;" Header="{l:T Tab_Usage}" DataContext="{Binding Usage}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Usage}" Subtitle="{l:T Usage_Subtitle}">
                    <c:PageHeader.Actions>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Periods}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding PeriodDays}" Width="140" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Secondary}" Content="{l:T Btn_Refresh}" Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{l:T Usage_NoLaunches}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Visibility="{Binding LaunchesAvailable, Converter={StaticResource BoolVisInv}}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
                </StackPanel>

                <!-- Biểu đồ cột một chuỗi: thời gian dùng máy theo giờ (không cần chú giải: tiêu đề đã nêu) -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding TotalText}" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
                            <TextBlock Text="{l:T Usage_Hourly}" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Hours}" Height="162">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Vùng nhận chuột cao hết biểu đồ để dễ trỏ vào cột thấp -->
                                    <Grid Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>
                                        <Border Height="{Binding Height}" VerticalAlignment="Bottom" Margin="1,0"
                                                Background="{DynamicResource ChartBar}" CornerRadius="4,4,0,0" />
                                        <Border Grid.Row="1" Background="{DynamicResource Hairline}" />
                                        <TextBlock Grid.Row="2" Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                   HorizontalAlignment="Left" Foreground="{DynamicResource InkMuted}" Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TableCard}">
                    <DataGrid c:Table.Apply="True" ItemsSource="{Binding Apps}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Col_App}" Binding="{Binding Name}" Width="180" />
                            <DataGridTemplateColumn Header="{l:T Col_ActiveTime}" Width="140" SortMemberPath="ActiveSeconds">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActiveText}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T Col_Launches}" Width="110" SortMemberPath="Launches">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Launches}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T Col_Sessions}" Width="100" SortMemberPath="Sessions">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Sessions}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T Col_Path}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Exe}" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Exe}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{l:T Usage_Pin}" Style="{StaticResource Link}"
                                                Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ===================== TIẾN TRÌNH ===================== -->
        <TabItem Tag="&#xE9D9;" Header="{l:T Tab_Processes}" DataContext="{Binding Processes}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Processes}" Subtitle="{l:T Proc_Subtitle}">
                    <c:PageHeader.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Secondary}" Content="{l:T Left_Open}" Command="{Binding OpenLeftoversCommand}"
                                    ToolTip="{l:T Left_Subtitle}" />
                            <Button Style="{StaticResource Primary}" Content="{l:T Proc_FreeMemory}" Command="{Binding FreeMemoryCommand}"
                                    IsEnabled="{Binding Busy, Converter={StaticResource Not}}" ToolTip="{l:T Proc_FreeMemoryHint}" />
                        </StackPanel>
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />

                <!-- Chỉ số tức thời: CPU, RAM, số tiến trình, số app chạy ngầm (lưới lệch, không chia 4 thẻ bằng nhau) -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding CpuTotalText}" Style="{StaticResource BigNumber}" Margin="0,4,0,8" />
                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding CpuTotal, Mode=OneWay}" Maximum="100" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RAM" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding RamText}" Style="{StaticResource BigNumber}" FontSize="20" Margin="0,10,0,10" TextWrapping="Wrap" />
                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding RamUsedRatio, Mode=OneWay}" />
                            </StackPanel>
                            <!-- Ổ đĩa: % thời gian bận của ổ bận nhất (Active time như Task Manager) -->
                            <StackPanel Grid.Column="4" ToolTip="{l:T Proc_DiskHint}">
                                <TextBlock Text="{l:T Proc_Disk}" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding DiskBusyText}" Style="{StaticResource BigNumber}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"
                                           FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding DiskBusy, Mode=OneWay}" Maximum="100" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T Proc_Count}" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding ProcessCount}" Style="{StaticResource BigNumber}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{l:T Proc_BackgroundApps}" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding BackgroundCount}" Style="{StaticResource BigNumber}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Cảnh báo app chạy ngầm -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,14">
                    <StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox Content="{l:T Proc_AlertsEnabled}" IsChecked="{Binding AlertsEnabled}" Margin="0,0,20,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Proc_AlertCpu}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding AlertCpu}" Width="56" Margin="0,0,16,0" />
                            <TextBlock Text="{l:T Proc_AlertRam}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding AlertRamMb}" Width="72" Margin="0,0,16,0" />
                            <TextBlock Text="{l:T Proc_AlertSeconds}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding AlertSeconds}" Width="64" Margin="0,0,16,0" />
                            <Button Style="{StaticResource Secondary}" Content="{l:T Btn_Save}" Command="{Binding SaveAlertsCommand}" />
                        </WrapPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="{l:T Proc_IgnoredLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding IgnoredText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" ToolTip="{l:T Proc_IgnoredHint}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Chẩn đoán lag: chỉ hiện khi CPU/ổ đĩa/RAM quá tải -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource WarningWash}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16"
                        Visibility="{Binding HasLag, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{l:T Lag_Title}" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding LagCauses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource LevelIcon}" Text="&#xE7BA;" FontSize="13"
                                                   VerticalAlignment="Top" Margin="0,2,10,0" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Lọc -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Kinds}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding KindFilter}" Width="230" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource InkMuted}" Margin="0,0,10,0" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="{l:T Prio_Search}" />
                </DockPanel>

                <Border Style="{StaticResource TableCard}">
                    <DataGrid c:Table.Apply="True" ItemsSource="{Binding View}" IsReadOnly="True" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:T Col_App}" Width="*" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkMuted}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T Col_Kind}" Width="120" SortMemberPath="Kind">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgeNeutral}">
                                            <TextBlock Text="{Binding KindText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{l:T Col_Processes}" Width="90" SortMemberPath="Count">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- CPU và RAM: số + thanh ngang mảnh (một chuỗi, cùng màu biểu đồ) -->
                            <DataGridTemplateColumn Header="CPU" Width="140" SortMemberPath="Cpu">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Style="{StaticResource Meter}" Height="6" Background="Transparent"
                                                         Foreground="{DynamicResource ChartBar}" Value="{Binding CpuRatio, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource Num}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="RAM" Width="160" SortMemberPath="Ram">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="76" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Style="{StaticResource Meter}" Height="6" Background="Transparent"
                                                         Foreground="{DynamicResource ChartBar}" Value="{Binding RamRatio, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding RamText}" Style="{StaticResource Num}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="160" SortMemberPath="Io">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{l:T Proc_DiskColumn}" ToolTip="{l:T Proc_IoHint}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="82" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Style="{StaticResource Meter}" Height="6" Background="Transparent"
                                                         Foreground="{DynamicResource ChartBar}" Value="{Binding IoRatio, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding IoText}" Style="{StaticResource Num}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="400">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{l:T Proc_Restart}" Style="{StaticResource Link}"
                                                    Visibility="{Binding CanRestart, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.RestartAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding CanAct, Converter={StaticResource BoolVis}}">
                                            <Button Content="{l:T Proc_Trim}" Style="{StaticResource Link}"
                                                    Command="{Binding DataContext.TrimAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{l:T Proc_EndTask}" Style="{StaticResource Link}" Foreground="{DynamicResource Critical}"
                                                    Command="{Binding DataContext.EndTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{l:T Sug_OpenFolder}" Style="{StaticResource Link}"
                                                    Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <!-- Chuột phải: bỏ qua cảnh báo chạy ngầm / không bao giờ cho ngủ đông -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="{l:T Proc_IgnoreAlerts}"
                                                      Command="{Binding PlacementTarget.Tag.IgnoreAlertsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="{l:T Proc_NeverHibernate}" IsEnabled="{Binding CanAct}"
                                                      Command="{Binding PlacementTarget.Tag.NeverHibernateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ===================== NGỦ ĐÔNG ===================== -->
        <TabItem Tag="&#xE708;" Header="{l:T Tab_Hibernation}" DataContext="{Binding Hibernation}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Hibernation}" Subtitle="{l:T Hib_Subtitle}">
                    <c:PageHeader.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Secondary}" Content="{l:T Hib_WakeAll}" Command="{Binding WakeAllCommand}" />
                            <Button Style="{StaticResource Primary}" Content="{l:T Btn_Save}" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1000">
                        <!-- Giải thích cách hoạt động và giới hạn -->
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                <TextBlock Text="{l:T Hib_Explain}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <!-- Cài đặt -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <c:SettingRow Title="{l:T Hib_Enabled}" Description="{l:T Hib_EnabledDesc}">
                                    <CheckBox IsChecked="{Binding Enabled}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Hib_IdleMinutes}">
                                    <TextBox Text="{Binding IdleMinutes}" Width="72" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Hib_OnlyMinimized}" Description="{l:T Hib_OnlyMinimizedDesc}">
                                    <CheckBox IsChecked="{Binding OnlyMinimized}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Hib_MinRam}" BorderThickness="0">
                                    <TextBox Text="{Binding MinRamMb}" Width="72" />
                                </c:SettingRow>
                            </StackPanel>
                        </Border>

                        <!-- Không bao giờ ngủ: kéo tâm ngắm thả lên cửa sổ app (kiểu EVKey) hoặc gõ tên -->
                        <DockPanel Margin="0,4,0,4">
                            <TextBlock Text="{Binding Excluded.Count}" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Hib_ExcludedLabel}" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <TextBlock Text="{l:T Hib_ExcludedDesc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <c:WindowPicker PickedCommand="{Binding PickedCommand}" HoverCommand="{Binding PickHoverCommand}" />
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{l:T Hib_PickerTitle}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding PickerText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Text="{Binding NewExcludedName, UpdateSourceTrigger=PropertyChanged}" Width="170"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5" ToolTip="{l:T Hib_AddByNameHint}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddExcludedByNameCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Style="{StaticResource Secondary}" Content="{l:T Hib_AddByName}" Command="{Binding AddExcludedByNameCommand}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource TableCard}">
                                    <DataGrid c:Table.Apply="True" ItemsSource="{Binding Excluded}" SelectedItem="{Binding SelectedExcluded}" IsReadOnly="True" MinHeight="320" MaxHeight="520"
                                              SelectionChanged="ScrollSelectedIntoView">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="{l:T Col_App}" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{l:T Hib_ProcessName}" Width="220">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkMuted}" FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="12" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{l:T Hib_Remove}" Style="{StaticResource Link}"
                                                                Command="{Binding DataContext.RemoveExcludedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Đang ngủ đông -->
                        <DockPanel Margin="0,4,0,10">
                            <TextBlock Text="{Binding SleepingSummary}" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Hib_Sleeping}" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasSleeping, Converter={StaticResource BoolVisInv}}">
                            <TextBlock Text="{l:T Hib_NoneSleeping}" Style="{StaticResource Muted}" />
                        </Border>
                        <Border Style="{StaticResource TableCard}" Margin="0,0,0,16" Visibility="{Binding HasSleeping, Converter={StaticResource BoolVis}}">
                            <DataGrid c:Table.Apply="True" ItemsSource="{Binding Sleeping}" IsReadOnly="True" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{l:T Col_App}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T Hib_Since}" Binding="{Binding SinceText}" Width="110" />
                                    <DataGridTextColumn Header="{l:T Hib_RamFreed}" Binding="{Binding RamText}" Width="140" />
                                    <DataGridTextColumn Header="{l:T Col_Processes}" Binding="{Binding Count}" Width="100" />
                                    <DataGridTemplateColumn Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{l:T Hib_Wake}" Style="{StaticResource Link}"
                                                        Command="{Binding DataContext.WakeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Theo dõi: app nào sắp ngủ, app nào không được ngủ và vì sao -->
                        <TextBlock Text="{l:T Hib_Watch}" Style="{StaticResource CardTitle}" Margin="0,4,0,4" />
                        <TextBlock Text="{l:T Hib_WatchDesc}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource TableCard}">
                            <DataGrid c:Table.Apply="True" ItemsSource="{Binding Watch}" IsReadOnly="True" MaxHeight="360" MinHeight="80">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{l:T Col_App}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" />
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkMuted}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T Hib_IdleFor}" Binding="{Binding IdleText}" Width="130" />
                                    <DataGridTemplateColumn Header="{l:T Col_Status}" Width="260">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource LevelIcon}" Text="&#xE946;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="240">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{l:T Hib_SleepNow}" Style="{StaticResource Link}"
                                                            Visibility="{Binding CanSleepNow, Converter={StaticResource BoolVis}}"
                                                            Command="{Binding DataContext.SleepNowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="{l:T Hib_Never}" Style="{StaticResource Link}"
                                                            Visibility="{Binding CanExclude, Converter={StaticResource BoolVis}}"
                                                            Command="{Binding DataContext.ExcludeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ===================== ƯU TIÊN & EXCEL ===================== -->
        <TabItem Tag="&#xE945;" Header="{l:T Tab_Priority}" DataContext="{Binding Priority}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Priority}" Subtitle="{l:T Prio_Intro}">
                    <c:PageHeader.Actions>
                        <Button Style="{StaticResource Primary}" Content="{l:T Btn_Save}" Command="{Binding SaveCommand}" />
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="960">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{l:T Prio_Section}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                <c:SettingRow Title="{l:T Prio_Enabled}">
                                    <CheckBox IsChecked="{Binding Enabled}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Prio_TopN}">
                                    <TextBox Text="{Binding TopUsedCount}" Width="64" VerticalContentAlignment="Center" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Prio_AllowHigh}" BorderThickness="0">
                                    <CheckBox IsChecked="{Binding AllowHigh}" />
                                </c:SettingRow>
                            </StackPanel>
                        </Border>

                        <!-- Chọn app để ưu tiên: mỗi app một dòng, đổi lựa chọn là lưu ngay -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="{l:T Btn_Refresh}"
                                            Command="{Binding LoadAppsCommand}" />
                                    <TextBlock Text="{l:T Prio_PickTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{l:T Prio_PickDesc}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                                <DockPanel Margin="0,0,0,10">
                                    <CheckBox DockPanel.Dock="Right" Content="{l:T Prio_OnlyRunning}" IsChecked="{Binding OnlyRunning}" Margin="12,0,0,0" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource InkMuted}" Margin="0,0,10,0" />
                                    <TextBox Text="{Binding AppFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="{l:T Prio_Search}" />
                                </DockPanel>
                                <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="8" Padding="2,2,2,0">
                                    <DataGrid c:Table.Apply="True" ItemsSource="{Binding AppsView}" MaxHeight="340" MinHeight="120"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="{l:T Col_App}" Width="*" SortMemberPath="DisplayName">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkMuted}" FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{l:T Col_Processes}" Width="100" SortMemberPath="Processes">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ProcessesText}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="RAM" Width="110" SortMemberPath="WorkingSet">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding RamText}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{l:T Col_Choice}" Width="170" SortMemberPath="Choice">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.Choices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Value" MinHeight="28"
                                                                  SelectedValue="{Binding Choice, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <!-- Thêm app chưa mở theo tên process -->
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Text="{l:T Prio_AddLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="{l:T Prio_Add}" Command="{Binding AddAppCommand}" />
                                    <TextBox Text="{Binding NewAppName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                             ToolTip="{l:T Prio_AddHint}" />
                                </DockPanel>
                                <TextBlock Text="{Binding ChosenSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{l:T Prio_Managed}" Style="{StaticResource CardTitle}" Margin="0,4,0,10" />
                        <Border Style="{StaticResource TableCard}" Margin="0,0,0,16">
                            <DataGrid c:Table.Apply="True" ItemsSource="{Binding Managed}" IsReadOnly="True" MaxHeight="260" MinHeight="80">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T Col_App}" Binding="{Binding Name}" Width="*" />
                                    <DataGridTemplateColumn Header="{l:T Col_Processes}" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Processes}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T Col_Original}" Binding="{Binding Original}" Width="140" />
                                    <DataGridTextColumn Header="{l:T Col_Applied}" Binding="{Binding Applied}" Width="140" />
                                    <DataGridTextColumn Header="{l:T Col_Reason}" Binding="{Binding Reason}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{l:T Excel_Section}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                <c:SettingRow Title="{l:T Excel_Enabled}">
                                    <CheckBox IsChecked="{Binding ExcelEnabled}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Excel_Threshold}">
                                    <TextBox Text="{Binding HeavyFileMb}" Width="64" VerticalContentAlignment="Center" />
                                </c:SettingRow>
                                <DockPanel Margin="0,14,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="{l:T Excel_Analyze}"
                                            Command="{Binding PickAndAnalyzeCommand}" IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource InkMuted}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding ExcelStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Báo cáo phân tích file Excel -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding ReportTitle, Converter={StaticResource StrVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ReportTitle}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding ReportSummary}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Margin="0,4,0,12" />
                                <ItemsControl ItemsSource="{Binding ExcelSuggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource LevelBadge}" Width="104" Margin="0,0,14,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Severity}" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ===================== CÔNG CỤ: chụp màn hình, ghim cửa sổ, mini monitor ===================== -->
        <TabItem Tag="&#xE90F;" Header="{l:T Tab_Tools}" DataContext="{Binding Tools}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Tools}" Subtitle="{l:T Tools_Subtitle}">
                    <c:PageHeader.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Secondary}" Content="{l:T Cap_Full}" Command="{Binding CaptureFullCommand}" />
                            <Button Style="{StaticResource Primary}" Content="{l:T Cap_Region}" Command="{Binding CaptureRegionCommand}" />
                        </StackPanel>
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1000">
                        <!-- Phím tắt -->
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="{l:T Hotkey_Reset}" Command="{Binding ResetHotkeysCommand}" />
                            <TextBlock Text="{l:T Hotkey_Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <c:SettingRow Title="{l:T Hotkey_Enabled}" Description="{l:T Hotkey_EnabledDesc}">
                                    <CheckBox IsChecked="{Binding HotkeysEnabled}" />
                                </c:SettingRow>
                                <ItemsControl ItemsSource="{Binding Hotkeys}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="200" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <c:HotkeyBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=Explicit}" />
                                                <Button Grid.Column="2" Style="{StaticResource Link}" Content="{l:T Hotkey_Clear}" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.ClearHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource Warning}" Margin="0,0,6,0"
                                                               Visibility="{Binding HasError, Converter={StaticResource BoolVis}}" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Chụp màn hình -->
                        <TextBlock Text="{l:T Cap_Title}" Style="{StaticResource CardTitle}" Margin="0,4,0,4" />
                        <TextBlock Text="{l:T Cap_Desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <c:SettingRow Title="{l:T Cap_OpenEditor}" Description="{l:T Cap_OpenEditorDesc}">
                                    <CheckBox IsChecked="{Binding OpenEditor}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Cap_CopyClipboard}">
                                    <CheckBox IsChecked="{Binding CopyToClipboard}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Cap_AutoSave}" Description="{l:T Cap_AutoSaveDesc}">
                                    <CheckBox IsChecked="{Binding AutoSave}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Cap_Folder}" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SaveFolder}" FontFamily="{StaticResource MonoFont}" FontSize="12" MaxWidth="380"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SaveFolder}" />
                                        <Button Style="{StaticResource Link}" Content="{l:T Disk_Browse}" Command="{Binding BrowseFolderCommand}" Margin="10,0,0,0" />
                                        <Button Style="{StaticResource Link}" Content="{l:T Sug_OpenFolder}" Command="{Binding OpenFolderCommand}" />
                                    </StackPanel>
                                </c:SettingRow>
                            </StackPanel>
                        </Border>

                        <!-- Ghim cửa sổ luôn trên cùng -->
                        <DockPanel Margin="0,4,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Link}" Content="{l:T Pin_UnpinAll}" Command="{Binding UnpinAllCommand}" />
                                <Button Style="{StaticResource Link}" Content="{l:T Btn_Refresh}" Command="{Binding RefreshWindowsCommand}" />
                            </StackPanel>
                            <TextBlock Text="{l:T Pin_Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{l:T Pin_Desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <c:WindowPicker PickWindow="True" PickedCommand="{Binding PinPickedCommand}" HoverCommand="{Binding PinHoverCommand}" />
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{l:T Pin_PickerTitle}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding PickerText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource TableCard}">
                                    <DataGrid c:Table.Apply="True" ItemsSource="{Binding Windows}" IsReadOnly="True" MinHeight="160" MaxHeight="360">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="{l:T Pin_ColWindow}" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"
                                                                       Visibility="{Binding IsTopMost, Converter={StaticResource BoolVis}}" />
                                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{l:T Col_App}" Binding="{Binding App}" Width="200" />
                                            <DataGridTemplateColumn Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding ActionText}" Style="{StaticResource Link}"
                                                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Mini monitor -->
                        <TextBlock Text="{l:T Mini_Title}" Style="{StaticResource CardTitle}" Margin="0,4,0,4" />
                        <TextBlock Text="{l:T Mini_Desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <c:SettingRow Title="{l:T Mini_Show}">
                                    <CheckBox IsChecked="{Binding OverlayVisible}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Mini_Metrics}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding ShowCpu}" Content="CPU" Margin="0,0,16,0" />
                                        <CheckBox IsChecked="{Binding ShowGpu}" Content="GPU" Margin="0,0,16,0" />
                                        <CheckBox IsChecked="{Binding ShowRam}" Content="RAM" Margin="0,0,16,0" />
                                        <CheckBox IsChecked="{Binding ShowDisk}" Content="Disk" />
                                    </StackPanel>
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Mini_Horizontal}">
                                    <CheckBox IsChecked="{Binding Horizontal}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Mini_Size}">
                                    <ComboBox ItemsSource="{Binding Sizes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding OverlaySize}" Width="140" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Mini_ClickThrough}" Description="{l:T Mini_ClickThroughDesc}">
                                    <CheckBox IsChecked="{Binding ClickThrough}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Mini_Position}" BorderThickness="0">
                                    <Button Style="{StaticResource Secondary}" Content="{l:T Mini_ResetPosition}" Command="{Binding ResetOverlayPositionCommand}" />
                                </c:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ===================== CÀI ĐẶT ===================== -->
        <TabItem Tag="&#xE713;" Header="{l:T Tab_Settings}" DataContext="{Binding Settings}">
            <DockPanel Style="{StaticResource Page}">
                <c:PageHeader DockPanel.Dock="Top" Title="{l:T Tab_Settings}" Subtitle="{l:T Set_Subtitle}">
                    <c:PageHeader.Actions>
                        <Button Style="{StaticResource Primary}" Content="{l:T Btn_Save}" Command="{Binding SaveCommand}" />
                    </c:PageHeader.Actions>
                </c:PageHeader>
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource StatusBar}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{l:T Set_Appearance}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                <c:SettingRow Title="{l:T Set_Language}">
                                    <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Language}" Width="180" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Set_Theme}" Description="{l:T Set_ThemeDesc}" BorderThickness="0">
                                    <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Theme}" Width="180" />
                                </c:SettingRow>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{l:T Set_Behaviour}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                <c:SettingRow Title="{l:T Set_StartWithWindows}">
                                    <CheckBox IsChecked="{Binding StartWithWindows}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Set_UsageEnabled}">
                                    <CheckBox IsChecked="{Binding UsageEnabled}" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Set_Retention}">
                                    <TextBox Text="{Binding RetentionDays}" Width="72" VerticalContentAlignment="Center" />
                                </c:SettingRow>
                                <c:SettingRow Title="{l:T Set_BackupKeep}" BorderThickness="0">
                                    <TextBox Text="{Binding BackupKeepDays}" Width="72" VerticalContentAlignment="Center" />
                                </c:SettingRow>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:T Set_Data}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                <TextBlock Text="{l:T Set_Privacy}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="{l:T Set_OpenData}" Command="{Binding OpenDataFolderCommand}" />
                                    <TextBlock Text="{Binding DataDir}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DataDir}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0">
                                    <Run Text="Manager Windows" /> <Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
