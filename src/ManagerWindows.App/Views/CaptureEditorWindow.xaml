<Window x:Class="ManagerWindows.App.Views.CaptureEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ManagerWindows.App.Services"
        xmlns:c="clr-namespace:ManagerWindows.App.Controls"
        Title="{l:T Cap_EditorTitle}" Width="1000" Height="700" MinWidth="720" MinHeight="420"
        Icon="/Assets/app.ico" WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <!-- Nút công cụ dạng chọn một (RadioButton có template riêng: không dùng theme Aero) -->
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentWash}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Ô màu: Background = màu vẽ -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="{DynamicResource Hairline}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Thanh công cụ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Secondary}" Content="{l:T Cap_Undo}" Click="OnUndo" ToolTip="Ctrl+Z" />
                    <Button Style="{StaticResource Secondary}" Content="{l:T Cap_SaveAs}" Click="OnSaveAs" />
                    <Button Style="{StaticResource Secondary}" Content="{l:T Cap_Save}" Click="OnSave" ToolTip="Ctrl+S" />
                    <Button Style="{StaticResource Primary}" Content="{l:T Cap_Copy}" Click="OnCopy" ToolTip="Ctrl+C" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton x:Name="ToolRect" Style="{StaticResource ToolButton}" GroupName="tool" Tag="&#xE739;" Content="{l:T Cap_ToolRect}" ToolTip="1" Checked="OnTool" IsChecked="True" />
                    <RadioButton x:Name="ToolEllipse" Style="{StaticResource ToolButton}" GroupName="tool" Tag="&#xEA3A;" Content="{l:T Cap_ToolEllipse}" ToolTip="2" Checked="OnTool" />
                    <RadioButton x:Name="ToolArrow" Style="{StaticResource ToolButton}" GroupName="tool" Tag="&#xE72A;" Content="{l:T Cap_ToolArrow}" ToolTip="3" Checked="OnTool" />
                    <RadioButton x:Name="ToolHighlight" Style="{StaticResource ToolButton}" GroupName="tool" Tag="&#xE7E6;" Content="{l:T Cap_ToolHighlight}" ToolTip="4" Checked="OnTool" />
                    <RadioButton x:Name="ToolRedact" Style="{StaticResource ToolButton}" GroupName="tool" Tag="&#xE91F;" Content="{l:T Cap_ToolRedact}" ToolTip="5" Checked="OnTool" />
                    <RadioButton x:Name="ToolNumber" Style="{StaticResource ToolButton}" GroupName="tool" Tag="&#xE8EF;" Content="{l:T Cap_ToolNumber}" ToolTip="6" Checked="OnTool" />
                    <Rectangle Width="1" Height="22" Fill="{DynamicResource Hairline}" Margin="8,0,12,0" />
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="22" Fill="{DynamicResource Hairline}" Margin="8,0,12,0" />
                    <ComboBox x:Name="ThicknessBox" Width="110" VerticalAlignment="Center" SelectionChanged="OnThickness" ToolTip="{l:T Cap_Thickness}" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <!-- Chân: thông tin ảnh + trạng thái -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Text="{l:T Cap_EditorHint}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <!-- Ảnh: thu nhỏ cho vừa cửa sổ, không phóng to quá kích thước gốc -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                <c:AnnotationCanvas x:Name="Board" />
            </Border>
        </Viewbox>
    </DockPanel>
</Window>
