<Window x:Class="ManagerWindows.App.Views.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ManagerWindows.App.Services"
        Title="{Binding Title}" Width="960" Height="620" MinWidth="700" MinHeight="400"
        Icon="/Assets/app.ico" Background="{StaticResource Panel}" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10"
                Visibility="{Binding ShowRiskNote, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{l:T Review_Note}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" />
        </Border>
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="{l:T Review_IncludeAll}" Command="{Binding IncludeVisibleCommand}" />
                <Button Content="{l:T Review_ExcludeAll}" Command="{Binding ExcludeVisibleCommand}" Margin="0" />
            </StackPanel>
            <TextBlock Text="{l:T Review_Filter}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=300}" VerticalContentAlignment="Center"
                     Margin="0,0,12,0" MinHeight="28" />
        </DockPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding View}" EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{l:T Col_Delete}" Width="56" SortMemberPath="Include">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{l:T Col_Path}" Width="*" SortMemberPath="RelativePath">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RelativePath}" ToolTip="{Binding Path}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:T Col_Size}" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="{l:T Col_Modified}" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="130" IsReadOnly="True" />
                <DataGridTemplateColumn Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{l:T Sug_OpenFolder}" Style="{StaticResource Link}"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="{l:T Review_Cancel}" IsCancel="True" />
                <Button Content="{l:T Review_Done}" Style="{StaticResource Primary}" IsDefault="True" Click="Done_Click" Margin="0" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
        </DockPanel>
    </Grid>
</Window>
