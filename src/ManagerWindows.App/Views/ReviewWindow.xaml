<Window x:Class="ManagerWindows.App.Views.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ManagerWindows.App.Services"
        xmlns:c="clr-namespace:ManagerWindows.App.Controls"
        Title="{Binding Title}" Width="980" Height="640" MinWidth="720" MinHeight="420"
        Icon="/Assets/app.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel Margin="28,24,28,20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />

        <!-- Cảnh báo cho mục "nên xem lại" -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource WarningWash}" CornerRadius="10" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding ShowRiskNote, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warning}" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock Text="{l:T Review_Note}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Chân: tóm tắt + nút -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource Secondary}" Content="{l:T Review_Cancel}" IsCancel="True" />
                <Button Style="{StaticResource Primary}" Content="{l:T Review_Done}" IsDefault="True" Click="Done_Click" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
        </DockPanel>

        <!-- Lọc + chọn nhanh -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource Secondary}" Content="{l:T Review_IncludeAll}" Command="{Binding IncludeVisibleCommand}" />
                <Button Style="{StaticResource Secondary}" Content="{l:T Review_ExcludeAll}" Command="{Binding ExcludeVisibleCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource InkMuted}" Margin="0,0,10,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=300}" VerticalContentAlignment="Center"
                     ToolTip="{l:T Review_Filter}" Margin="0,0,8,0" />
        </DockPanel>

        <Border Style="{StaticResource TableCard}">
            <DataGrid c:Table.Apply="True" ItemsSource="{Binding View}" EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{l:T Col_Delete}" Width="64" SortMemberPath="Include">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{l:T Col_Path}" Width="*" SortMemberPath="RelativePath">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativePath}" ToolTip="{Binding Path}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{l:T Col_Size}" Width="100" SortMemberPath="Size">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" Margin="0,0,12,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{l:T Col_Modified}" Width="140" SortMemberPath="Modified">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ModifiedText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{l:T Sug_OpenFolder}" Style="{StaticResource Link}"
                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
