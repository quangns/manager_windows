<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu Dark — nguồn: docs/design/DESIGN.md. ThemeManager hoán đổi file này khi đổi sáng/tối. -->
    <SolidColorBrush x:Key="Canvas" Color="#09090B" />
    <SolidColorBrush x:Key="Surface" Color="#18181B" />
    <SolidColorBrush x:Key="Raised" Color="#27272A" />
    <SolidColorBrush x:Key="Ink" Color="#FAFAFA" />
    <SolidColorBrush x:Key="InkMuted" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Hairline" Color="#2E2E33" />
    <SolidColorBrush x:Key="Accent" Color="#2A9D8F" />
    <SolidColorBrush x:Key="AccentHover" Color="#34B3A3" />
    <SolidColorBrush x:Key="AccentPressed" Color="#238579" />
    <SolidColorBrush x:Key="AccentOn" Color="#09090B" />
    <SolidColorBrush x:Key="AccentWash" Color="#12302D" />
    <SolidColorBrush x:Key="ChartBar" Color="#2A9D8F" />
    <SolidColorBrush x:Key="Good" Color="#4ADE80" />
    <SolidColorBrush x:Key="GoodWash" Color="#0F2A1A" />
    <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningWash" Color="#2E2109" />
    <SolidColorBrush x:Key="Critical" Color="#F87171" />
    <SolidColorBrush x:Key="CriticalWash" Color="#2F1313" />
</ResourceDictionary>
