<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ManagerWindows.App</AssemblyName>
    <RootNamespace>ManagerWindows.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ManagerWindows.Core\ManagerWindows.Core.csproj" />
    <ProjectReference Include="..\ManagerWindows.Platform\ManagerWindows.Platform.csproj" />
    <ProjectReference Include="..\ManagerWindows.Storage\ManagerWindows.Storage.csproj" />
    <ProjectReference Include="..\ManagerWindows.Ipc\ManagerWindows.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\%(Filename)%(Extension)" />
    <EmbeddedResource Include="Lang\*.json" />
    <!-- Để rules nằm ngoài file exe (bản portable một file) cho người dùng sửa được -->
    <None Include="..\..\rules\*.json" Link="rules\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
