<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ManagerWindows.Service</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ManagerWindows.Core\ManagerWindows.Core.csproj" />
    <ProjectReference Include="..\ManagerWindows.Platform\ManagerWindows.Platform.csproj" />
    <ProjectReference Include="..\ManagerWindows.Storage\ManagerWindows.Storage.csproj" />
    <ProjectReference Include="..\ManagerWindows.Ipc\ManagerWindows.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\rules\*.json" Link="rules\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
